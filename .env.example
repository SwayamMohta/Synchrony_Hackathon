# PostgreSQL / pgvector
DATABASE_URL=postgresql+psycopg2://uw:uw@localhost:5432/underwriting
POSTGRES_USER=uw
POSTGRES_PASSWORD=uw
POSTGRES_DB=underwriting

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_MIN=120

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# LLM for the RAG assistant (leave LLM_API_KEY blank to use the offline fallback).
# Any OpenAI-compatible free provider works. The generic LLM_* vars take priority;
# the GEMINI_* vars below are the Gemini-specific fallback.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_ID=

# Gemini (Google AI Studio) - free tier
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Other providers (example — fill key, uncomment):
# Groq (high free rate limits):
#   LLM_API_KEY=<key>  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL_ID=groq/compound-mini
# Cerebras (fast free tier):
#   LLM_API_KEY=<key>  LLM_BASE_URL=https://api.cerebras.ai/v1  LLM_MODEL_ID=llama-3.3-70b
# OpenRouter (free models):
#   LLM_API_KEY=<key>  LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL_ID=deepseek/deepseek-chat-v3-0324:free

# RAG embedding model + policy corpus directory
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
POLICIES_DIR=policies

# Cross-encoder reranker (phase-2 relevance upgrade). Downloads ~90MB on first
# use; when unavailable, retrieval gracefully falls back to RRF-only ordering.
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Feature metadata path (optional override)
FEATURE_METADATA=ml/feature_metadata.json
